#!/usr/bin/env bash
# win-a11y-shell launcher script — Inicia a sessão nativa do MATE com tema do Windows 11 e Orca
set -e

# Corrigir XDG_RUNTIME_DIR e DBUS para o usuário da sessão (evitar /run/user/0 do root)
USER_UID=$(id -u)
export XDG_RUNTIME_DIR="/run/user/${USER_UID}"
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true

export DISPLAY="${DISPLAY:-:0}"
export GTK_MODULES=gail:atk-bridge
export QT_ACCESSIBILITY=1
export NO_AT_BRIDGE=0
export ACCESSIBILITY_ENABLED=1
export GNOME_ACCESSIBILITY=1
export LANG=pt_BR.UTF-8
export LC_ALL=pt_BR.UTF-8
export LANGUAGE=pt_BR:pt
export PYTHONPATH="/opt/win-a11y-shell/orca/src:$PYTHONPATH"

# Aplicar tema Fluent-Dark do Windows 11 no MATE e GTK3 e ATIVAR ACESSIBILIDADE MATE
gsettings set org.mate.panel.general default-layout 'redmond' 2>/dev/null || true
gsettings set org.mate.interface accessibility true 2>/dev/null || true
gsettings set org.mate.interface gtk-theme 'Fluent-Dark' 2>/dev/null || true
gsettings set org.gnome.desktop.interface gtk-theme 'Fluent-Dark' 2>/dev/null || true
gsettings set org.gnome.desktop.interface toolkit-accessibility true 2>/dev/null || true
gsettings set org.gnome.desktop.a11y.applications screen-reader-enabled true 2>/dev/null || true

# Iniciar Orca personalizado do usuário logado
pkill -u "$USER_UID" -f "orca" 2>/dev/null || true
sleep 1
nohup env PYTHONPATH="/opt/win-a11y-shell/orca/src" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" /usr/local/bin/orca --replace > /tmp/win_a11y_orca.log 2>&1 &

# Executar a sessão do MATE Desktop (MATE Panel + Marco)
exec mate-session
