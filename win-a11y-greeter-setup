#!/usr/bin/env bash
# win-a11y-greeter-setup — Executado pelo lightdm como ROOT antes do greeter aparecer

# Adicionar lightdm aos grupos de som e entrada
usermod -aG audio,input,pulse,pulse-access lightdm 2>/dev/null || true

# Permissões de pasta e áudio
chown -R lightdm:lightdm /var/lib/lightdm 2>/dev/null || true
chmod -R 755 /var/lib/lightdm 2>/dev/null || true
chmod -R 755 /opt/win-a11y-shell 2>/dev/null || true
chmod 666 /dev/snd/* 2>/dev/null || true

# Liberar acesso X11 para o usuário lightdm
xhost +local:lightdm 2>/dev/null || xhost + 2>/dev/null || true

# Matar instâncias antigas de QUALQUER usuário no display antes de iniciar no greeter
pkill -9 -f orca 2>/dev/null || true
sleep 1

# Iniciar AT-SPI bus e Orca para o usuário lightdm na tela de login
(
    runuser -u lightdm -- env \
        DISPLAY=:0 \
        XAUTHORITY=/var/run/lightdm/root/:0 \
        HOME=/var/lib/lightdm \
        PYTHONPATH="/opt/win-a11y-shell/orca/src" \
        LANG=pt_BR.UTF-8 \
        LC_ALL=pt_BR.UTF-8 \
        LANGUAGE=pt_BR:pt \
        GTK_MODULES=gail:atk-bridge \
        NO_AT_BRIDGE=0 \
        ACCESSIBILITY_ENABLED=1 \
        GNOME_ACCESSIBILITY=1 \
        /usr/local/bin/orca --replace > /tmp/win_a11y_orca_greeter.log 2>&1 &

    # Forçar foco na janela do greeter e simular Tab para acionar fala do Orca
    sleep 2
    XAUTHORITY=/var/run/lightdm/root/:0 DISPLAY=:0 xdotool search --onlyvisible --class "lightdm-gtk-greeter" windowfocus key Tab 2>/dev/null || true
) &

exit 0
