#!/usr/bin/env bash
# /usr/local/bin/win-a11y-greeter-setup
# Executado pelo lightdm ANTES de mostrar o greeter (como root)
# Inicia Orca acessível na tela de login

export DISPLAY=:0
export XAUTHORITY=/var/run/lightdm/root/:0
export GTK_MODULES=gail:atk-bridge
export NO_AT_BRIDGE=0
export ACCESSIBILITY_ENABLED=1
export GNOME_ACCESSIBILITY=1
export LANG=pt_BR.UTF-8
export LC_ALL=pt_BR.UTF-8
export LANGUAGE=pt_BR:pt
export PYTHONPATH="/opt/win-a11y-shell/orca/src:${PYTHONPATH}"

# Garantir que o at-spi2 está ativo para o greeter
gsettings set org.gnome.desktop.interface toolkit-accessibility true 2>/dev/null || true

# Iniciar Orca como usuário lightdm (quem roda o greeter)
# sudo -u lightdm não funciona bem com Orca — roda como root no display do greeter
nohup env \
    DISPLAY=:0 \
    XAUTHORITY=/var/run/lightdm/root/:0 \
    GTK_MODULES=gail:atk-bridge \
    NO_AT_BRIDGE=0 \
    ACCESSIBILITY_ENABLED=1 \
    GNOME_ACCESSIBILITY=1 \
    LANG=pt_BR.UTF-8 \
    LC_ALL=pt_BR.UTF-8 \
    LANGUAGE=pt_BR:pt \
    PYTHONPATH="/opt/win-a11y-shell/orca/src" \
    /usr/local/bin/orca --replace > /tmp/win_a11y_orca_greeter.log 2>&1 &

echo "[greeter-setup] Orca iniciado na tela de login (PID $!)"
